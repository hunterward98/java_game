<!-- Character Creation Template -->
<table fillParent="true">
    <label style="title">Create Your Character</label>
    <row padBottom="20" />

    <!-- Name input section -->
    <table pad="10">
        <label>Character Name:</label>
        <row />
        <textField id="nameInput" maxLength="20" messageText="Enter name..." width="300" height="50" />
    </table>

    <row padTop="20" />

    <!-- Buttons -->
    <table pad="15">
        <textButton id="startGameButton" onChange="onStartGame" disabled="true">Start Game</textButton>
        <row />
        <textButton onChange="onBack">Back</textButton>
    </table>
</table>
