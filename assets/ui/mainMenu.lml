<!-- Main Menu Template -->
<table fillParent="true">
    <!-- Title/Logo Area -->
    <label style="title">Inherit This</label>
    <row />

    <!-- Main Menu Buttons (shown by default) -->
    <table id="mainMenuButtons" pad="15">
        <textButton id="newGameButton" onChange="onNewGame">New Game</textButton>
        <row />
        <textButton id="loadGameButton" onChange="onLoadGame">Load Game</textButton>
        <row />
        <textButton id="exitButton" onChange="onExit">Exit</textButton>
    </table>

    <!-- Save Slot Selection (hidden by default) -->
    <table id="saveSlotMenu" pad="15" visible="false">
        <label style="subtitle">Select Save Slot</label>
        <row />

        <!-- Slot 1 -->
        <table>
            <textButton id="slot1Button" onChange="onLoadSlot" userData="0">Slot 1: Empty</textButton>
            <textButton id="deleteSlot1Button" onChange="onDeleteSlot" userData="0" visible="false">Delete</textButton>
        </table>
        <row />

        <!-- Slot 2 -->
        <table>
            <textButton id="slot2Button" onChange="onLoadSlot" userData="1">Slot 2: Empty</textButton>
            <textButton id="deleteSlot2Button" onChange="onDeleteSlot" userData="1" visible="false">Delete</textButton>
        </table>
        <row />

        <!-- Slot 3 -->
        <table>
            <textButton id="slot3Button" onChange="onLoadSlot" userData="2">Slot 3: Empty</textButton>
            <textButton id="deleteSlot3Button" onChange="onDeleteSlot" userData="2" visible="false">Delete</textButton>
        </table>
        <row />

        <textButton id="backButton" onChange="onBack">Back</textButton>
    </table>

    <!-- Delete Confirmation Dialog (hidden by default) -->
    <table id="deleteConfirmDialog" pad="20" visible="false">
        <label id="deleteWarningLabel">Delete save in slot 1?</label>
        <row />
        <label>This action cannot be undone!</label>
        <row />

        <textButton id="confirmDeleteButton" onChange="onConfirmDelete">Confirm Delete</textButton>
        <row />
        <textButton id="cancelDeleteButton" onChange="onCancelDelete">Cancel</textButton>
    </table>
</table>
