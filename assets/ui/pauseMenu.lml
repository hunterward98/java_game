<!-- Pause Menu Template -->
<table fillParent="true">
    <label style="title">Paused</label>
    <row />

    <table pad="15">
        <textButton onChange="onResume">Resume</textButton>
        <row />
        <textButton onChange="onSettings">Settings</textButton>
        <row />
        <textButton onChange="onSaveExit">Save &amp; Exit</textButton>
    </table>
</table>
