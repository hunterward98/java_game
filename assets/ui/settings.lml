<!-- Settings Screen Template -->
<table fillParent="true">
    <label style="title">Settings</label>
    <row padBottom="20" />

    <!-- Sound Settings Panel -->
    <table pad="20">
        <label style="subtitle">Sound Settings</label>
        <row />

        <!-- Master Volume -->
        <label>Master Volume:</label>
        <slider id="masterVolumeSlider" min="0" max="100" stepSize="1" width="300" />
        <label id="masterVolumeLabel">100</label>
        <row />

        <!-- Area SFX Volume -->
        <label>Area SFX:</label>
        <slider id="areaVolumeSlider" min="0" max="100" stepSize="1" width="300" />
        <label id="areaVolumeLabel">100</label>
        <row />

        <!-- UI SFX Volume -->
        <label>UI SFX:</label>
        <slider id="uiVolumeSlider" min="0" max="100" stepSize="1" width="300" />
        <label id="uiVolumeLabel">100</label>
        <row />

        <!-- Primary SFX Volume -->
        <label>Primary SFX:</label>
        <slider id="primaryVolumeSlider" min="0" max="100" stepSize="1" width="300" />
        <label id="primaryVolumeLabel">100</label>
    </table>

    <row padTop="20" />

    <!-- Back Button -->
    <textButton onChange="onBack">Back</textButton>
</table>
